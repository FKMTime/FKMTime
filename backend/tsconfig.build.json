{
  "extends": "./tsconfig.json",
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"],
  // Keeps `nest start --watch` to our own files. Polling (the Docker dev
  // stack) through all of node_modules' typings delays noticing a change by up
  // to a minute; rebuild after changing dependencies anyway.
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", "dist"],
    "excludeFiles": ["**/node_modules/**"]
  }
}
