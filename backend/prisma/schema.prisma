generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String               @id @default(uuid())
  password                   String?
  username                   String?              @unique
  roles                      Role[]               @default([])
  fullName                   String?              @map("full_name")
  wcaUserId                  Int?                 @map("wca_user_id")
  wcaAccessToken             String?              @map("wca_access_token")
  avatarUrl                  String?              @map("avatar_url")
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")
  quickActions               QuickAction[]
  updatedAttempts            Attempt[]
  createdNoteworthyIncidents NoteworthyIncident[]
  createdWarnings            Warning[]
  Result                     Result[]
  ManualIncident             ManualIncident[]
  attemptEditLogs            AttemptEditLog[]
  extraGrants                ExtraGrant[]
  removedResults             Result[]             @relation("result_removed_by")
  devicesPointedAtRound      Device[]             @relation("device_custom_round_set_by")

  @@map("users")
}

model Person {
  id                String           @id @default(uuid())
  registrantId      Int?             @unique @map("registrant_id")
  // The WCA registration's database id, which WCA Integrated Live Results
  // calls registration_id (SPEC-006); null for people created on site
  wcaRegistrationId Int?             @map("wca_registration_id")
  name              String
  wcaId             String?          @map("wca_id")
  countryIso2       String?          @map("country_iso_2")
  gender            String?
  canCompete        Boolean          @default(true) @map("can_compete")
  birthdate         DateTime?
  checkedInAt       DateTime?        @map("checked_in_at")
  cardId            String?          @unique @map("card_id")
  results           Result[]
  judgedAttempts    Attempt[]        @relation(name: "attempt_judge")
  StaffActivity     StaffActivity[]  @relation(name: "staff_activity_person")
  replacedOthersIn  StaffActivity[]  @relation(name: "staff_activity_replaced_by")
  scrambledAttempts Attempt[]        @relation(name: "attempt_scrambler")
  receivedWarnings  Warning[]
  manualIncidents   ManualIncident[]
  judgedEditLogs    AttemptEditLog[] @relation(name: "edit_log_judge")
  scrambledEditLogs AttemptEditLog[] @relation(name: "edit_log_scrambler")

  @@map("person")
}

model StaffActivity {
  id           String              @id @default(uuid())
  personId     String              @map("person_id")
  person       Person              @relation(name: "staff_activity_person", fields: [personId], references: [id], onDelete: Cascade)
  deviceId     String?             @map("device_id")
  device       Device?             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  isAssigned   Boolean             @default(false) @map("is_assigned")
  status       StaffActivityStatus @default(ABSENT)
  groupId      String              @map("group_id")
  comment      String?
  role         StaffRole
  /// Left before the group ended; only with PRESENT or LATE
  leftEarly    Boolean             @default(false) @map("left_early")
  /// Not coming for the rest of the day; only with ABSENT
  noShow       Boolean             @default(false) @map("no_show")
  /// Who did the job instead; only with REPLACED or ABSENT
  replacedById String?             @map("replaced_by_id")
  replacedBy   Person?             @relation(name: "staff_activity_replaced_by", fields: [replacedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@unique([personId, groupId, role])
  @@map("staff_activity")
}

model Competition {
  id                              String                  @id @default(uuid())
  wcaId                           String                  @map("wca_id")
  sendingResultsFrequency         SendingResultsFrequency @map("sending_results_frequency")
  name                            String
  countryIso2                     String?                 @map("country_iso_2")
  shouldUpdateDevices             Boolean                 @default(false) @map("should_update_devices")
  shouldChangeGroupsAutomatically Boolean                 @default(false) @map("should_change_groups_automatically")
  wifiSsid                        String?                 @map("wifi_ssid")
  wifiPassword                    String?                 @map("wifi_password")
  mdns                            Boolean                 @default(true)
  wsUrl                           String?                 @map("ws_url")
  wcif                            Json?
  scoretakingToken                String?                 @map("scoretaking_token")
  scoretakingTokenUpdatedAt       DateTime?               @map("scoretaking_token_updated_at")
  // Mirrors scoretaking_software on the WCA website; null until first read
  wcaScoretakingSoftware          String?                 @map("wca_scoretaking_software")
  wcaScoretakingCheckedAt         DateTime?               @map("wca_scoretaking_checked_at")
  // The WCA account results are entered as in integrated live results; the
  // tokens are encrypted (src/secret-box.ts)
  wcaLiveConnectedById            String?                 @map("wca_live_connected_by_id")
  wcaLiveConnectedWcaUserId       Int?                    @map("wca_live_connected_wca_user_id")
  wcaLiveConnectedName            String?                 @map("wca_live_connected_name")
  wcaLiveCanEnterScores           Boolean?                @map("wca_live_can_enter_scores")
  wcaLiveAccessToken              String?                 @map("wca_live_access_token")
  wcaLiveRefreshToken             String?                 @map("wca_live_refresh_token")
  wcaLiveTokenExpiresAt           DateTime?               @map("wca_live_token_expires_at")
  wcaLiveConnectionBrokenAt       DateTime?               @map("wca_live_connection_broken_at")
  // Off: FKMTime suggests opening later rounds in WCA Integrated Live Results
  // and a person clicks, because opening one locks the round before it
  openRoundsAutomatically         Boolean                 @default(false) @map("open_rounds_automatically")
  cubingContestsToken             String?                 @map("cubing_contests_token")
  defaultLocale                   String?                 @default("en") @map("default_locale")
  fkmToken                        Int                     @map("fkm_token")
  secureRfid                      Boolean                 @default(false) @map("secure_rfid")
  useFkmTimeDevices               Boolean                 @default(true) @map("use_fkm_time_devices")
  soundEnabled                    Boolean                 @default(true) @map("sound_enabled")
  // Null leaves each V4 station on the volume set in its own menu
  buzzerVolume                    Int?                    @map("buzzer_volume")

  @@map("competition")
}

model UnofficialEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique @map("event_id")
  wcif      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("unofficial_event")
}

model Room {
  id                String             @id @default(uuid())
  name              String
  color             String
  currentGroupIds   String[]           @map("current_group_ids")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  devices           Device[]
  scramblingDevices ScramblingDevice[]

  @@map("room")
}

model Result {
  id                  String       @id @default(uuid())
  personId            String       @map("person_id")
  person              Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  eventId             String       @map("event_id")
  roundId             String       @map("round_id")
  doubleCheckedBy     User?        @relation(fields: [doubleCheckedById], references: [id], onDelete: SetNull)
  doubleCheckedById   String?      @map("double_checked_by")
  doubleCheckedAt     DateTime?    @map("double_checked_at")
  isDoubleChecked     Boolean      @default(false) @map("is_double_checked")
  attempts            Attempt[]
  extraGrants         ExtraGrant[]
  liveSync            LiveSync?
  /// Removed under Regulation 9t: kept, but left out of every list (SPEC-005)
  removedAt           DateTime?    @map("removed_at")
  removedById         String?      @map("removed_by_id")
  removedBy           User?        @relation("result_removed_by", fields: [removedById], references: [id], onDelete: SetNull)
  removedReason       String?      @map("removed_reason")
  /// The result whose DNF ruling removed this one; restoring it brings this back
  removedByRulingOfId String?      @map("removed_by_ruling_of_id")
  removedByRulingOf   Result?      @relation("result_removed_by_ruling", fields: [removedByRulingOfId], references: [id], onDelete: SetNull)
  removedByRuling     Result[]     @relation("result_removed_by_ruling")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@unique([personId, roundId])
  @@map("result")
}

model Attempt {
  id                 String               @id @default(uuid())
  sessionId          String?              @map("session_id")
  resultId           String               @map("result_id")
  result             Result?              @relation(fields: [resultId], references: [id], onDelete: Cascade)
  attemptNumber      Int                  @map("attempt_number")
  replacedBy         Int?                 @map("replaced_by")
  comment            String?
  type               AttemptType          @default(STANDARD_ATTEMPT)
  status             AttemptStatus        @default(STANDARD)
  penalty            Int?
  value              Int
  originalTime       Int?                 @map("original_time")
  inspectionTime     Int?                 @map("inspection_time")
  judgeId            String?              @map("judge_id")
  judge              Person?              @relation(fields: [judgeId], references: [id], name: "attempt_judge")
  scramblerId        String?              @map("scrambler_id")
  scrambler          Person?              @relation(fields: [scramblerId], references: [id], name: "attempt_scrambler")
  scrambledAt        DateTime?            @map("scrambled_at")
  deviceId           String?              @map("device_id")
  device             Device?              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  solvedAt           DateTime?            @map("solved_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  updatedById        String?              @map("updated_by_id")
  updatedBy          User?                @relation(fields: [updatedById], references: [id])
  noteworthyIncident NoteworthyIncident[]
  editLogs           AttemptEditLog[]
  extraGrantId       String?              @map("extra_grant_id")
  extraGrant         ExtraGrant?          @relation(fields: [extraGrantId], references: [id], onDelete: SetNull)
  statusBeforeGrant  AttemptStatus?       @map("status_before_grant")
  statusInGrant      AttemptStatus?       @map("status_in_grant")
  replacedByInGrant  Int?                 @map("replaced_by_in_grant")

  @@map("attempt")
}

model ExtraGrant {
  id          String    @id @default(uuid())
  resultId    String    @map("result_id")
  result      Result    @relation(fields: [resultId], references: [id], onDelete: Cascade)
  useFreshSet Boolean   @map("use_fresh_set")
  createdById String?   @map("created_by_id")
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  restoredAt  DateTime? @map("restored_at")
  attempts    Attempt[]

  @@map("extra_grant")
}

model AttemptEditLog {
  id             String        @id @default(uuid())
  attemptId      String        @map("attempt_id")
  attempt        Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  editedAt       DateTime      @map("edited_at")
  editedById     String?       @map("edited_by_id")
  editedBy       User?         @relation(fields: [editedById], references: [id], onDelete: SetNull)
  comment        String?
  value          Int
  penalty        Int?
  status         AttemptStatus
  type           AttemptType
  attemptNumber  Int           @map("attempt_number")
  replacedBy     Int?          @map("replaced_by")
  judgeId        String?       @map("judge_id")
  judge          Person?       @relation(fields: [judgeId], references: [id], onDelete: SetNull, name: "edit_log_judge")
  scramblerId    String?       @map("scrambler_id")
  scrambler      Person?       @relation(fields: [scramblerId], references: [id], onDelete: SetNull, name: "edit_log_scrambler")
  deviceId       String?       @map("device_id")
  device         Device?       @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  attemptComment String?       @map("attempt_comment")

  @@map("attempt_edit_log")
}

model NoteworthyIncident {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  attemptId   String?  @map("attempt_id")
  attempt     Attempt? @relation(fields: [attemptId], references: [id])
  createdById String   @map("created_by")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([attemptId])
  @@map("noteworthy_incident")
}

model Warning {
  id          String   @id @default(uuid())
  description String   @db.Text
  personId    String   @map("person_id")
  person      Person   @relation(fields: [personId], references: [id])
  createdById String   @map("created_by")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("warning")
}

model ManualIncident {
  id           String   @id @default(uuid())
  personId     String   @map("person_id")
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  roundId      String?
  description  String
  attempt      String?
  isNoteworthy Boolean  @default(false)
  createdById  String   @map("created_by")
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("manual_incident")
}

model Device {
  id                 String           @id @default(uuid())
  name               String           @unique
  espId              Int?             @unique @map("esp_id")
  signKey            Int?             @unique @map("sign_key")
  type               DeviceType
  batteryPercentage  Int?             @map("battery_percentage")
  hwVersion          HardwareVersion? @map("hw_version")
  firmwareVersion    String?          @map("firmware_version")
  // Set instead of deleting a device that has history, so its attempts keep their station
  retiredAt          DateTime?        @map("retired_at")
  /// The round this station takes attempts for instead of its room's groups,
  /// e.g. "333-r1" (SPEC-007). Null while it follows its room.
  customRoundId      String?          @map("custom_round_id")
  customRoundSetAt   DateTime?        @map("custom_round_set_at")
  customRoundSetById String?          @map("custom_round_set_by_id")
  customRoundSetBy   User?            @relation("device_custom_round_set_by", fields: [customRoundSetById], references: [id], onDelete: SetNull)
  roomId             String           @map("room_id")
  room               Room             @relation(fields: [roomId], references: [id])
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  Attempt            Attempt[]
  StaffActivity      StaffActivity[]
  AttemptEditLog     AttemptEditLog[]

  @@map("device")
}

model QuickAction {
  id        String   @id @default(uuid())
  name      String
  comment   String?
  giveExtra Boolean  @default(false) @map("give_extra")
  isShared  Boolean  @default(true) @map("is_shared")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("quick_action")
}

model ScramblingDevice {
  id                   String   @id @default(uuid())
  name                 String
  encryptedToken       String?  @map("encrypted_token")
  encryptedOneTimeCode String?  @map("encrypted_one_time_code")
  roomId               String   @map("room_id")
  room                 Room     @relation(fields: [roomId], references: [id])
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("scrambling_device")
}

model ScrambleSet {
  id        String     @id @default(uuid())
  roundId   String     @map("round_id")
  set       String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  scrambles Scramble[]

  @@unique([roundId, set])
  @@map("scramble_set")
}

model Scramble {
  id                String      @id @default(uuid())
  scrambleSetId     String      @map("scramble_set_id")
  scrambleSet       ScrambleSet @relation(fields: [scrambleSetId], references: [id], onDelete: Cascade)
  num               Int         @map("num")
  isExtra           Boolean     @default(false) @map("is_extra")
  encryptedScramble String      @map("encrypted_scramble")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("scramble")
}

enum DeviceType {
  STATION
  ATTENDANCE_SCRAMBLER
  ATTENDANCE_RUNNER
}

enum AttemptType {
  STANDARD_ATTEMPT
  EXTRA_ATTEMPT
}

enum AttemptStatus {
  SCRAMBLED
  STANDARD
  UNRESOLVED
  RESOLVED
  EXTRA_GIVEN
  VOIDED
}

enum Role {
  ADMIN
  ORGANIZER
  DELEGATE
  STAGE_LEADER
  STAFF
}

enum StaffRole {
  COMPETITOR
  JUDGE
  RUNNER
  SCRAMBLER
  DELEGATE
  STAFF_OTHER
}

enum SendingResultsFrequency {
  AFTER_SOLVE
  EVERY_5_MINUTES
  NEVER
}

enum StaffActivityStatus {
  PRESENT
  ABSENT
  LATE
  REPLACED
}

enum HardwareVersion {
  V3
  V4
}

/// Where a result stands in WCA Integrated Live Results (SPEC-006)
enum LiveSyncStatus {
  DIRTY // changed since it was last sent
  SENT // the WCA accepted the write (202), not read back yet
  CONFIRMED // read back from the WCA and matches
  NOT_IN_ROUND // the WCA doesn't list the person in the round
  NOT_SENDABLE // e.g. the person has no WCA registration
  REJECTED // the WCA refused it, or it breaks the round's rules
}

model LiveSync {
  resultId         String         @id @map("result_id")
  result           Result         @relation(fields: [resultId], references: [id], onDelete: Cascade)
  status           LiveSyncStatus
  // Hash of the attempts last sent, compared with what the WCA holds
  sentHash         String?        @map("sent_hash")
  sentAt           DateTime?      @map("sent_at")
  // Read-backs that didn't match yet
  checks           Int            @default(0)
  // FKMTime removed the competitor from the round (Regulation 9t), so
  // restoring the result has to add them back first
  removedFromRound Boolean        @default(false) @map("removed_from_round")
  error            String?
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("live_sync")
}

/// A result deleted in FKMTime whose WCA Integrated Live Results copy still
/// has to be cleared; it outlives the deleted Result row
model LiveClear {
  id                String   @id @default(uuid())
  roundId           String   @map("round_id")
  wcaRegistrationId Int      @map("wca_registration_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([roundId, wcaRegistrationId])
  @@map("live_clear")
}
